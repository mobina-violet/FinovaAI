generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum TransactionType {
  INCOME
  EXPENSE
}

enum ChequeType {
  RECEIVABLE // چک دریافتی
  PAYABLE // چک پرداختی
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

enum ChatRole {
  USER
  ASSISTANT
}
//کاربر
model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]
  sessions   Session[]
}
//رمز 6رقمی
//کدهای تأیید (فقط هش کد ذخیره می‌شه، تعداد تلاش و انقضا)
model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}
model Session {
  id        String   @id // هش SHA-256 توکن کوکی
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
//	نشست ورود (شناسه = هش توکن کوکی)
model Business {
  id        String   @id @default(cuid())
  name      String
  type      String? // نوع کسب‌وکار؛ مثلا: کتاب‌فروشی
  ownerId   String
  createdAt DateTime @default(now())

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories    Category[]
  transactions  Transaction[]
  cheques       Cheque[]
  notifications Notification[]
  chatMessages  ChatMessage[]

  @@index([ownerId])
}

model Category {
  id         String          @id @default(cuid())
  businessId String
  name       String
  type       TransactionType

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([businessId, name, type])
}
//	تراکنش (مبلغ BigInt به تومان، تعداد، توضیح، تاریخ)
model Transaction {
  id          String          @id @default(cuid())
  businessId  String
  categoryId  String?
  type        TransactionType
  amount      BigInt // به تومان، بدون اعشار
  quantity    Int? // مثلا تعداد کتاب فروخته‌شده
  description String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  deletedAt   DateTime? // حذف نرم: null یعنی تراکنش فعاله

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([businessId, occurredAt])
}
//	چک (دریافتی/پرداختی، سررسید، وضعیت)
model Cheque {
  id         String       @id @default(cuid())
  businessId String
  type       ChequeType
  amount     BigInt
  dueDate    DateTime
  partyName  String? // طرف حساب
  bank       String?
  number     String?
  status     ChequeStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dueDate, status])
}
//اعلان
model Notification {
  id         String              @id @default(cuid())
  businessId String
  title      String
  body       String
  channel    NotificationChannel @default(IN_APP)
  sendAt     DateTime
  sentAt     DateTime?
  readAt     DateTime?
  createdAt  DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sendAt])
}
//پیام‌های چت با دستیار
model ChatMessage {
  id         String   @id @default(cuid())
  businessId String
  role       ChatRole
  content    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  topic     String
  message   String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}